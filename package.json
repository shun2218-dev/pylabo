{
  "name": "python-tutorial",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ブラウザだけで学べる Python 学習アプリ（Pyodide + React + TypeScript）",
  "scripts": {
    "postinstall": "node scripts/sync-pyodide.mjs && node scripts/fetch-pyodide-packages.mjs",
    "sync:pyodide": "node scripts/sync-pyodide.mjs",
    "fetch:packages": "node scripts/fetch-pyodide-packages.mjs",
    "dev": "npm run sync:pyodide && vite",
    "build": "npm run sync:pyodide && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "verify:exercises": "node scripts/verify-exercises.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.27.0",
    "markdown-it": "^14.3.0",
    "pyodide": "^314.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^26.1.0",
    "sass": "^1.94.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
